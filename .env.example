# Copia este archivo a .env.local para desarrollo y configura las mismas variables en Vercel › Settings › Environment Variables

# Claude (asistente Guía Nariño)
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-haiku-4-5 (rápido y económico). Para respuestas más ricas: claude-sonnet-4-5
ANTHROPIC_MODEL=claude-haiku-4-5

# ElevenLabs (voces de las audioguías)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ES=
ELEVENLABS_VOICE_EN=
# Opcional. Por defecto eleven_multilingual_v2
ELEVENLABS_MODEL=eleven_multilingual_v2

# Seguridad del chat (opcionales)
# Dominios autorizados a usar /api/chat, separados por coma. Ej: https://descubre-narino.vercel.app
ALLOWED_ORIGINS=
# Mensajes por minuto por visitante (por defecto 12)
CHAT_RATE_PER_MIN=12

# Propuesta descargable (lead capture → Resend + Vercel KV + Vercel Blob)
RESEND_API_KEY=
RESEND_FROM=Descubre Nariño <propuesta@tu-dominio-verificado.com>
# Vercel KV (Storage → Create Database → KV; se inyectan solas al conectar el proyecto)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# URL pública del PDF subido a Vercel Blob (Storage → Create Database → Blob)
PROPUESTA_PDF_URL=
# Dominio base para armar el link del correo (por defecto usa el de producción)
SITE_URL=https://descubrenarino-qmes.vercel.app
# Mensajes por minuto por visitante (por defecto 5)
PROPUESTA_RATE_PER_MIN=5

# Panel /admin (leads + estadísticas) — Basic Auth, hash guardado en KV tras el primer acceso
ADMIN_USER=
ADMIN_PASS_INICIAL=
# Pageviews/clics por minuto por visitante antes de limitar (por defecto 60)
TRACK_RATE_PER_MIN=60
